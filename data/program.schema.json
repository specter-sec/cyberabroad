{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specter-sec.github.io/cyberabroad/data/program.schema.json",
  "title": "CyberAbroad program record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "university", "country", "program", "degree", "annual_tuition", "deadline", "language", "scholarships", "scholarships_note", "required_documents", "gre", "program_url", "last_verified", "verification_notes", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "university": {"type": "string", "minLength": 3, "maxLength": 160},
    "country": {"enum": ["Germany", "Canada", "UK", "Netherlands", "Sweden", "Finland", "Australia", "Malaysia", "Turkey", "USA"]},
    "program": {"type": "string", "minLength": 3, "maxLength": 200},
    "degree": {"enum": ["Bachelors", "Masters", "PhD"]},
    "annual_tuition": {
      "type": "object", "additionalProperties": false,
      "required": ["amount", "currency", "fee_year", "basis", "notes", "source_url"],
      "properties": {
        "amount": {"type": ["number", "null"], "minimum": 0},
        "currency": {"enum": ["EUR", "CAD", "GBP", "SEK", "AUD", "MYR", "TRY", "USD"]},
        "fee_year": {"type": "string", "minLength": 1},
        "basis": {"enum": ["published_annual", "annualized_estimate", "unknown"]},
        "notes": {"type": "string", "minLength": 1},
        "source_url": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"}
      }
    },
    "deadline": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "cycle", "notes", "source_url"],
      "properties": {
        "date": {"type": ["string", "null"], "format": "date"},
        "cycle": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1},
        "source_url": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"}
      }
    },
    "language": {
      "type": "object", "additionalProperties": false,
      "required": ["ielts_overall", "notes", "source_url"],
      "properties": {
        "ielts_overall": {"type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5},
        "notes": {"type": "string", "minLength": 1},
        "source_url": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"}
      }
    },
    "scholarships": {
      "type": "array", "maxItems": 6,
      "items": {"type": "object", "additionalProperties": false, "required": ["name", "eligibility", "url"], "properties": {"name": {"type": "string", "minLength": 1}, "eligibility": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}}}
    },
    "scholarships_note": {"type": "string", "minLength": 1},
    "required_documents": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "gre": {"type": "object", "additionalProperties": false, "required": ["status", "notes", "source_url"], "properties": {"status": {"enum": ["required", "not_required", "optional", "unknown"]}, "notes": {"type": "string", "minLength": 1}, "source_url": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"}}},
    "program_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "last_verified": {"type": "string", "format": "date"},
    "verification_notes": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "object", "additionalProperties": false, "required": ["url", "title", "fields"], "properties": {"url": {"type": "string", "format": "uri", "pattern": "^https://"}, "title": {"type": "string", "minLength": 1}, "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["program", "tuition", "deadline", "language", "scholarships", "documents", "gre"]}}}}}
  }
}
